# ====================================================
# FarmerConnect - Environment Configuration
# ====================================================

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=farmerconnect-college-dev-secret-key-change-in-prod

# Data.gov.in Official API Configuration (Optional)
# If provided, FarmerConnect retrieves live agricultural market prices from data.gov.in (Agmarknet)
# Register for free at https://data.gov.in to obtain an API key.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Database Configuration
DATABASE_PATH=farmerconnect.db

# Default Location Settings (Tamil Nadu, India)
DEFAULT_LOCATION_NAME=Coimbatore
DEFAULT_LATITUDE=11.0055
DEFAULT_LONGITUDE=76.9661
